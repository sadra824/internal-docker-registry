{
    // تنظیمات Cloudflare Workers — npx wrangler dev / npx wrangler deploy
    // نام باید با ورکر پروداکشن (متصل به registry.sadhanet.com) یکی باشد
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "sadhanet-registry",
    "main": "src/index.js",
    "compatibility_date": "2025-09-01",
    // بک‌اند serverless-registry به nodejs_compat نیاز دارد
    "compatibility_flags": ["nodejs_compat"],

    // لندینگ پیج (پوشه public) به‌صورت Static Assets سرو می‌شود
    "assets": {
        "directory": "./public"
    },

    // ⚠️ بدون R2 و بدون کش: هیچ بایندینگی به R2 وجود ندارد و هیچ داده‌ای
    // ذخیره نمی‌شود. هر pull مستقیماً از رجیستری‌های بالادستی استریم می‌شود.

    // متغیرهای محیطی (env.X — نه process.env)
    "vars": {
        "SOURCE_BASE_URL": "https://dockerimagesave.akiel.dev/image",

        // بک‌اند /v2 (serverless-registry) — رجیستری‌های بالادستی ناشناس:
        // هر pull به‌ترتیب از این‌ها گرفته و مستقیم به کلاینت پاس داده می‌شود.
        // برای رجیستری خصوصی: username و password_env اضافه کنید و توکن را با
        // wrangler secret put تنظیم کنید (هرگز توکن را این‌جا ننویسید).
        "REGISTRIES_JSON": "[{ \"registry\": \"https://docker.arvancloud.ir/\" },{ \"registry\": \"https://index.docker.io/\" },{ \"registry\": \"https://ghcr.io/\" },{ \"registry\": \"https://registry.k8s.io/\" },{ \"registry\": \"https://quay.io/\" },{ \"registry\": \"https://gcr.io/\" },{ \"registry\": \"https://public.ecr.aws/\" },{ \"registry\": \"https://mcr.microsoft.com/\" },{ \"registry\": \"https://registry.gitlab.com/\" },{ \"registry\": \"https://nvcr.io/\" },{ \"registry\": \"https://icr.io/\" },{ \"registry\": \"https://registry.cn-hangzhou.aliyuncs.com/\" }]"
    }

    // ⚠️ احراز هویت حذف شده — pull کاملاً ناشناس است.
    // secretهای USERNAME/PASSWORD اگر قبلاً set شده‌اند دیگر اثری ندارند؛
    // برای تمیزی می‌توانید حذفشان کنید:
    //   npx wrangler secret delete USERNAME
    //   npx wrangler secret delete PASSWORD

    // ─── فهرست رجیستری‌های مسیر /image (اختیاری) ───
    // پیش‌فرض: همان ۱۳ رجیستری داخل src/services/registries.js
    // "PASSTHROUGH_REGISTRIES_JSON": "[\"docker.arvancloud.ir\", \"docker.io\"]"
}
