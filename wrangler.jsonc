{
    // تنظیمات Cloudflare Workers — npx wrangler dev / npx wrangler deploy
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "sadhanet-registry",
    "main": "src/index.js",
    "compatibility_date": "2025-09-01",

    // لندینگ پیج (پوشه public) به‌صورت Static Assets سرو می‌شود —
    // فایل‌های موجود را خود پلتفرم می‌دهد و بقیه درخواست‌ها به Worker می‌رسد.
    "assets": {
        "directory": "./public"
    },

    // متغیرهای محیطی (env.X — نه process.env)
    "vars": {
        "SOURCE_BASE_URL": "https://dockerimagesave.akiel.dev/image",
        "DEFAULT_PLATFORM_OS": "linux",
        "DEFAULT_PLATFORM_ARCH": "amd64"
    }

    // نکته: این سرویس هیچ داده‌ای ذخیره نمی‌کند؛ نه کش، نه R2، نه Cron.
    // همه‌چیز استریمی پاس داده می‌شود و فقط متادیتای کوچک در حافظه‌ی
    // isolate (تا ۱۰ دقیقه) نگه داشته می‌شود.
}
